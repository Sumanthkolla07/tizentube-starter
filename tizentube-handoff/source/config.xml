<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns:tizen="http://tizen.org/ns/widgets" xmlns="http://www.w3.org/ns/widgets" id="http://local/tizentubestarter" version="2.1.0" viewmodes="maximized">
    <access origin="*" subdomains="true"></access>
    <tizen:allow-navigation href="*"/>
    <tizen:application id="TTStartr01.TizenTubeStarter" package="TTStartr01" required_version="3.0"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <feature name="http://tizen.org/feature/web.service"/>
    <icon src="launcher-white-v209.png"/>
    <name>TizenTube Starter</name>
    <!-- Same privileges as TizenTube itself: the bundled proxy service is TizenTube's (fixed) proxy. -->
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <tizen:privilege name="http://tizen.org/privilege/unlimitedstorage"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/application.info"/>
    <tizen:profile name="tv-samsung"/>
    <!-- A copy of TizenTube's proxy (with the startup fix) that this app is allowed to start itself. -->
    <tizen:service id="TTStartr01.ProxyService" auto-restart="true" on-boot="true">
        <tizen:content src="service/dist/index.js"/>
        <tizen:name>ProxyService</tizen:name>
        <tizen:description>TizenTube proxy started by TizenTube Starter</tizen:description>
    </tizen:service>
    <tizen:setting screen-orientation="landscape" context-menu="enable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
